{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otkryvashka",
  "version": "1.0.0",
  "identifier": "app.otkryvashka.rust",
  "build": {
    "frontendDist": "../../app/src/main/assets/www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Открывашка",
        "width": 900,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
